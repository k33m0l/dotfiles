{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/k33m0l/Documents/Wallpapers/nyarchassistantlogo.png",
    "width": 30,
    "height": 14,
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "color": {
      "keys": "blue"
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      }
    },
    "separator": "   "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    {
      "type": "display",
      "detectName": true
    },
    "de",
    {
      "type": "cpu",
      "temp": true
    },
    "memory",
    "disk",
    "media",
    "battery",
    {
      "type": "localip",
      "showIpv6": true
    },
    "bluetooth",
  ]
}
